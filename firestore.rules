rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /blocker_disable_requests/{requestId} {
      allow create: if !('pinHash' in request.resource.data)
        && request.resource.data.status == 'pending';
      allow read: if true;
      allow update: if resource.data.status == 'pending'
        && !('pinHash' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'approvedByToken', 'pinHash'])
        && request.resource.data.approvedByToken == resource.data.token
        && request.resource.data.status != resource.data.status
        && (!('pinHash' in request.resource.data) || (request.resource.data.pinHash is string && request.resource.data.pinHash.size() == 64));
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
